<%# A native form that posts to Rails. %>
<%= appbar "Form" %>

<form action="form_submit" method="post">
  <%= column class: "p-6 gap-4" do %>
    <%= h2 "Tell us about you" %>
    <%= input "name", label: "Name", placeholder: "Ada Lovelace" %>
    <%= input "email", type: "email", label: "Email", placeholder: "you@example.com" %>
    <%= dropdown "locale", label: "Language", value: "en",
                 options: [%w[fr Français], %w[en English], %w[ar العربية]] %>
    <%= input "newsletter", type: "checkbox", label: "Subscribe to the newsletter", checked: true %>
    <%= submit "Send" %>
  <% end %>
</form>
