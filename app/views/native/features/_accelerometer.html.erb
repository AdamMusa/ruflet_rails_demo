<%= accelerometer on_reading_target: "sensor-status", on_reading_prefix: "Accelerometer: ", on_error_target: "sensor-status", on_error_prefix: "Accelerometer error: " %>
<%= text "Waiting for accelerometer reading...", id: "sensor-status", class: "text-sm text-slate-500 selectable" %>
<%= row class: "gap-2" do %>
  <%= button "Start", service: "accelerometer-start", interval: 500, result_target: "sensor-status" %>
  <%= button "Stop", service: "accelerometer-stop", result_target: "sensor-status" %>
<% end %>
