<%= clipboard %>
<%= text "Clipboard ready", id: "clipboard-status", class: "text-sm text-slate-500 selectable" %>
<%= row class: "gap-2 flex-wrap" do %>
  <%= button "Copy sample text", service: "clipboard-set", text: "Hello from Ruflet", result_target: "clipboard-status" %>
  <%= button "Read clipboard text", service: "clipboard-get", result_target: "clipboard-status" %>
  <%= button "Get image from clipboard", service: "clipboard-get-image", result_target: "clipboard-status" %>
<% end %>
