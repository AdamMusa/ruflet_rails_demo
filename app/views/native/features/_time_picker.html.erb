<%# Time picker — the date picker's twin. %>
<%= text "Time: —", id: "time-value", class: "text-lg font-semibold text-slate-700 select-text" %>
<%= button "Open time picker", icon: "schedule", service: "control", target: "demo-time-picker",
           method: "update", open: "true" %>

<%= time_picker id: "demo-time-picker", value: "09:41", help_text: "Pick a time",
                on_change_target: "time-value", on_change_prefix: "Time: " %>
