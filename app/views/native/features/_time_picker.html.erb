<%# Time picker — the date picker's twin. %>
<%= text "Time: —", id: "time-value", class: "text-lg font-semibold text-slate-700 selectable" %>
<%= button "Open time picker", icon: "schedule", service: "control", target: "demo-time-picker",
           method: "update", open: "true" %>

<time-picker id="demo-time-picker" open="false" value="09:41"
             help-text="Pick a time"
             on-change-target="time-value" on-change-prefix="Time: "></time-picker>
