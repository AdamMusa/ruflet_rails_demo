<%= audio id: "studio-audio", src: "https://github.com/bluefireteam/audioplayers/raw/main/packages/audioplayers/example/assets/audio/ambient_c_motion.mp3", autoplay: false, volume: 1.0, balance: 0.0, release_mode: "stop", on_loaded_target: "audio-status", on_loaded_message: "Audio loaded", on_duration_change_target: "audio-status", on_duration_change_prefix: "Duration: ", on_position_change_target: "audio-position", on_position_change_prefix: "Position: ", on_state_change_target: "audio-status", on_state_change_prefix: "State: ", on_error_target: "audio-status", on_error_prefix: "Audio error: " %>
<%= text "Audio ready", id: "audio-status", class: "text-sm text-slate-500 selectable" %>
<%= text "Position: 0", id: "audio-position", class: "text-sm text-slate-500 selectable" %>
<%= row class: "gap-2 flex-wrap" do %>
  <%= button "Play", service: "control", target: "studio-audio", method: "play", args: { position: 0 }, result_target: "audio-status" %>
  <%= button "Pause", service: "control", target: "studio-audio", method: "pause", result_target: "audio-status" %>
  <%= button "Resume", service: "control", target: "studio-audio", method: "resume", result_target: "audio-status" %>
  <%= button "Release", service: "control", target: "studio-audio", method: "release", result_target: "audio-status" %>
  <%= button "Seek 2s", service: "control", target: "studio-audio", method: "seek", args: { position: 2000 }, result_target: "audio-status" %>
  <%= button "Get duration", service: "control", target: "studio-audio", method: "get_duration", result_target: "audio-status" %>
  <%= button "Get position", service: "control", target: "studio-audio", method: "get_current_position", result_target: "audio-status" %>
<% end %>
