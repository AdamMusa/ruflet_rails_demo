<%# Dialog — a control like any other, opened and closed by setting its own
    open property, the way Studio's component-dialog does. %>
<%= text "The dialog is closed.", id: "dialog-status", class: "text-sm text-slate-500 select-text" %>
<%= button "Open dialog", icon: "chat_bubble", service: "control", target: "demo-dialog",
           method: "update", open: "true" %>

<%= alert_dialog id: "demo-dialog", modal: true do %>
  <%= text "Hello world from a Ruflet dialog." %>
  <%= button "Close", service: "control", target: "demo-dialog", method: "update",
             open: "false", variant: "text" %>
<% end %>
