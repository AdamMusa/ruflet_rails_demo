<%= flashlight %>
<%= text "Flashlight ready", id: "flashlight-status", class: "text-sm text-slate-500 selectable" %>
<%= row class: "gap-2" do %>
  <%= button "On", service: "flashlight-on", result_target: "flashlight-status" %>
  <%= button "Off", service: "flashlight-off", result_target: "flashlight-status" %>
<% end %>
