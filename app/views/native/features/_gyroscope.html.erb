<%= gyroscope on_reading_target: "sensor-status", on_reading_prefix: "Gyroscope: ", on_error_target: "sensor-status", on_error_prefix: "Gyroscope error: " %>
<%= text "Waiting for gyroscope reading...", id: "sensor-status", class: "text-sm text-slate-500 select-text" %>
<%= row class: "gap-2" do %>
  <%= button "Start", service: "gyroscope-start", interval: 500, result_target: "sensor-status" %>
  <%= button "Stop", service: "gyroscope-stop", result_target: "sensor-status" %>
<% end %>
