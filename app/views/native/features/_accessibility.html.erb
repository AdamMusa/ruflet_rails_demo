<%= semantics_service %>
<%= text "Semantics service ready", id: "semantics-status", class: "text-sm text-slate-500 selectable" %>
<%= row class: "gap-2 flex-wrap" do %>
  <%= button "Accessibility features", service: "semantics-features", result_target: "semantics-status" %>
  <%= button "Announce message", service: "semantics-announce", message: "Hello from Ruflet", result_target: "semantics-status" %>
  <%= button "Announce tooltip", service: "semantics-tooltip", message: "Ruflet tooltip", result_target: "semantics-status" %>
<% end %>
