<%= magnetometer on_reading_target: "sensor-status", on_reading_prefix: "Magnetometer: ", on_error_target: "sensor-status", on_error_prefix: "Magnetometer error: " %>
<%= text "Waiting for magnetometer reading...", id: "sensor-status", class: "text-sm text-slate-500 selectable" %>
<%= row class: "gap-2" do %>
  <%= button "Start", service: "magnetometer-start", interval: 500, result_target: "sensor-status" %>
  <%= button "Stop", service: "magnetometer-stop", result_target: "sensor-status" %>
<% end %>
