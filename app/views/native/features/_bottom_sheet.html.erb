<%# Bottom sheet — same shape as the dialog: an ordinary control until its
    open property is set. %>
<%= text "The sheet is closed.", id: "sheet-status", class: "text-sm text-slate-500 select-text" %>
<%= button "Open bottom sheet", icon: "expand_less", service: "control", target: "demo-sheet",
           method: "update", open: "true" %>

<%= bottom_sheet id: "demo-sheet" do %>
  <%= column class: "p-6 gap-3" do %>
    <%= h4 "Share this take" %>
    <%= text "A bottom sheet is a control that happens to slide up.",
             class: "text-sm text-slate-500" %>
    <%= button "Done", service: "control", target: "demo-sheet", method: "update",
               open: "false", variant: "filled" %>
  <% end %>
<% end %>
