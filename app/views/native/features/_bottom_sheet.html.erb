<%# Bottom sheet — same shape as the dialog: it is an ordinary control until
    its open property is set. %>
<%= text "The sheet is closed.", id: "sheet-status", class: "text-sm text-slate-500 selectable" %>
<%= button "Open bottom sheet", icon: "expand_less", service: "control", target: "demo-sheet",
           method: "update", open: "true", result_target: "sheet-status", toast: "Sheet opened" %>

<bottom-sheet id="demo-sheet" open="false">
  <column class="p-6 gap-3">
    <h4>Share this take</h4>
    <text class="text-sm text-slate-500">A bottom sheet is a control that happens to slide up.</text>
    <button service="control" target="demo-sheet" method="update" open="false"
            variant="filled" result-target="sheet-status" toast="Sheet closed">Done</button>
  </column>
</bottom-sheet>
