<%= file_picker %>
<%= text "File picker ready", id: "file-status", class: "text-sm text-slate-500 select-text" %>
<%= row class: "gap-2 flex-wrap" do %>
  <%= button "Pick files", service: "pick-files", allow_multiple: true, result_target: "file-status" %>
  <%= button "Pick directory", service: "pick-directory", result_target: "file-status" %>
  <%= button "Save file", service: "save-file", file_name: "ruflet.txt", file_type: "custom", allowed_extensions: ["txt"], src_bytes: "Hello from Ruflet", result_target: "file-status" %>
<% end %>
