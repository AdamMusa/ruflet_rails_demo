<%# h-full so the screen owns the whole viewport: examples with a preview,
    a map or a player can expand into it instead of sitting in a strip at the
    top with dead space underneath. %>
<%= appbar @feature_title %>

<% body_class = @feature == "webview" ? "h-full" : "p-6 gap-4 h-full" %>
<%= column class: body_class do %>
  <%= render partial: "native/features/#{@feature}" %>
<% end %>
