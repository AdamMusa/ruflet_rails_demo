<%# Home screen. %>
<%= appbar "Ruflet Native" %>

<%= column class: "p-6 gap-4" do %>
  <%= h1 "Native UI, from Rails" %>
  <%= text "Every screen here is a Rails view rendered as real native widgets.",
           class: "text-slate-500" %>

  <%= card class: "p-4" do %>
    <%= link nil, native_counter_path do %>
      <%= row class: "gap-3 items-center p-4" do %>
        <%= icon "add_circle", class: "text-emerald-600" %>
        <%= column class: "gap-1 flex-1" do %>
          <%= text "Counter", class: "font-semibold" %>
          <%= text "Actions that re-render in place", class: "text-sm text-slate-500" %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= card class: "p-4" do %>
    <%= link nil, native_form_path do %>
      <%= row class: "gap-3 items-center p-4" do %>
        <%= icon "edit_note", class: "text-sky-600" %>
        <%= column class: "gap-1 flex-1" do %>
          <%= text "Form", class: "font-semibold" %>
          <%= text "Native fields posting to Rails", class: "text-sm text-slate-500" %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= card class: "p-4" do %>
    <%= link nil, native_widgets_path do %>
      <%= row class: "gap-3 items-center p-4" do %>
        <%= icon "widgets", class: "text-violet-600" %>
        <%= column class: "gap-1 flex-1" do %>
          <%= text "Widget gallery", class: "font-semibold" %>
          <%= text "Every native component in one place", class: "text-sm text-slate-500" %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= card class: "p-4" do %>
    <%= link nil, whatsapp_path do %>
      <%= row class: "gap-3 items-center p-4" do %>
        <%= icon "chat", class: "text-emerald-600" %>
        <%= column class: "gap-1 flex-1" do %>
          <%= text "Chat app", class: "font-semibold" %>
          <%= text "Chats, bubbles, composer & tabs", class: "text-sm text-slate-500" %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= card class: "p-4" do %>
    <%= link nil, native_device_path do %>
      <%= row class: "gap-3 items-center p-4" do %>
        <%= icon "devices", class: "text-amber-600" %>
        <%= column class: "gap-1 flex-1" do %>
          <%= text "Device & media", class: "font-semibold" %>
          <%= text "Camera, sensors, maps & more", class: "text-sm text-slate-500" %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
